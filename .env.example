# Public DNS hostname pointing to the office network, without https://
SUPPORT_HOST=support.example.com
# Replace with the generated value from the deployment guide
DJANGO_SECRET_KEY=

# Optional SMS service
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
